# Core runtime
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
PROJECT_ROOT=/absolute/path/to/ai-platform
DATABASE_URL=sqlite:///./ai_workspace.db
REDIS_URL=redis://127.0.0.1:6379/0
AUTO_CREATE_DB_TABLES=true

# Generate unique values during installation. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-value
AUTH_TOKEN_SECRET=replace-with-a-different-long-random-value

# OpenAI-compatible providers (configure only what you use)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=
RUAPI_API_KEY=
RUAPI_BASE_URL=
CLAUDEHUB_API_KEY=
CLAUDEHUB_BASE_URL=

# Native providers
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional billing
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_SECRET=

# Optional password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Platform
SMTP_USE_TLS=true
