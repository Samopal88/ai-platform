[Unit]
Description=AI Workspace Platform Backend
After=network.target redis.service
Wants=network.target

[Service]
Type=simple
User=aiadmin
WorkingDirectory=/opt/ai-workspace/storage/projects/ai-platform/backend
EnvironmentFile=/opt/ai-workspace/storage/projects/ai-platform/backend/.env
ExecStart=/opt/ai-workspace/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=20
StandardOutput=append:/opt/ai-workspace/logs/ai-platform.log
StandardError=append:/opt/ai-workspace/logs/ai-platform.log

[Install]
WantedBy=multi-user.target
